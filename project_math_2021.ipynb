   "source": [
    "def price2 ( N, rN , hN , bN , s, f) :\n",
    "    \"\"\"\n",
    "    Calculate the price of a European call option using the binomial model with vectorized operations.\n",
    "\n",
    "    Parameters:\n",
    "    N (int): Number of time steps\n",
    "    rN (float): Risk-free interest rate per time step\n",
    "    hN (float): Up factor per time step\n",
    "    bN (float): Down factor per time step\n",
    "    s (float): Current stock price\n",
    "    f (float): Strike price\n",
    "\n",
    "    Returns:\n",
    "    float: Price of the European call option\n",
    "    \"\"\"\n",
    "    \n",
    "    qN = (rN - bN) / (hN - bN)\n",
    "    #Construct the tree \n",
    "    prices = np.zeros(N+1)\n",
    "    for k in range(N+1):\n",
    "        prices[k] = s * (1+hN)**k * (1+bN)**(N-k)  # Stock price at maturity\n",
    "    \n",
    "    V = [f(x) for x in prices]  # Payoffs at maturity\n",
    "    \n",
    "    # Backward induction to calculate option price\n",
    "    for k in range (N-1, -1,-1):\n",
    "        for i in range(0,k+1):\n",
    "            V[i] = ( 1/(1+rN))*(qN * V[i+1] + (1-qN)*V[i])\n",
    "            print(V[i])\n",
    "            print('\\n')\n",
    "         \n",
    "    return V"
   ]
  },
